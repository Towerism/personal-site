{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t personal-site .",
    "docker:tag": "docker tag personal-site martinfjr/personal-site:latest",
    "docker:push": "docker push martinfjr/personal-site:latest",
    "docker:deploy": "pnpm run docker:build && pnpm run docker:tag && pnpm run docker:push"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.9"
  }
}
